{
    "canisters": {
      "fusion-register": {
        "candid": "src/fusion_register/fusion_register.did",
        "declarations": {
          "node_compatibility": true
        },
        "package": "fusion_register",
        "type": "rust"
      },


      "fusion_pay": {
        "candid": "src/fusion_pay/fusion_pay.did",
        "declarations": {
          "node_compatibility": true
        },
        "package": "fusion_pay",
        "type": "rust"
      },

      "fusion_homepage": {
        
        "source": [
          "src/fusion_homepage/dist"
        ],
        "type": "assets",
        "workspace": "fusion_wallet_frontend"
      },

      "fusion_docs": {
        "source": [
          "src/fusion_docs/out"
        ],
        "type": "assets",
        "workspace": "fusion_docs"
      },

      "fusion-web": {
        "source": [
          "build/web/"
        ],
        "type": "assets"
      },

      "fusion-onchain-web": {
        "source": [
          "build/onchain_web/"
        ],
        "type": "assets"
      },

      "fusion-notify": {
        "candid": "src/fusion_notify/fusion_notify.did",
        "declarations": {
          "node_compatibility": true
        },
        "package": "fusion_notify",
        "type": "rust"
      }
    },
    "defaults": {
      "build": {
        "args": "",
        "packtool": ""
      }
    },
    "output_env_file": ".env",
    "version": 1
  }